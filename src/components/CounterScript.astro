<script>
const input=document.querySelector<HTMLTextAreaElement>('#text')!;
function update(){const text=input.value;const han=text.match(/\p{Script=Han}/gu)?.length??0;const rest=text.replace(/\p{Script=Han}/gu,' ');const segmenter=new Intl.Segmenter(document.documentElement.lang,{granularity:'word'});const words=han+[...segmenter.segment(rest)].filter(s=>s.isWordLike).length;document.querySelector('#words')!.textContent=String(words);document.querySelector('#characters')!.textContent=String([...text].length);document.querySelector('#minutes')!.textContent=String(Math.ceil(words/300));}
input.addEventListener('input',update);document.querySelector('#clear')!.addEventListener('click',()=>{input.value='';update();input.focus();});
</script>
