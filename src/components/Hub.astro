---
import Base from '../layouts/Base.astro';
import {getCollection} from 'astro:content';
import {ui,projects,updates,localized,type Lang} from '../data/hub';
interface Props {lang:Lang;page:'latest'|'work'|'thoughts'|'resources'|'about';filter?:'all'|'blog'|'videos'|'projects';}
const {lang,page,filter='all'}=Astro.props;
const t=ui[lang];const href=(path:string)=>localized(lang,path);
const posts=(await getCollection('blog',({data})=>!data.draft&&data.lang===lang)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const labels={update:t.update,project:t.projects,video:t.videos,thought:t.thoughts,resource:t.resources,blog:t.blog};
const entries=[...updates.filter(e=>!e.draft).map(e=>({id:e.id,date:e.date,type:e.type,title:e.title?.[lang],body:e.body[lang],url:href(`/updates/${e.id}/`)})),...posts.map(p=>({id:p.id,date:p.data.date.toISOString().slice(0,10),type:'blog' as const,title:p.data.title,body:p.data.description,url:href(`/blog/${p.id}/`)}))].sort((a,b)=>b.date.localeCompare(a.date)||a.id.localeCompare(b.id));
const feed=page==='thoughts'?entries.filter(e=>e.type==='thought'):entries;
---
<Base lang={lang} title={t[page]}>
{page==='latest' ? <div class="feed-intro"><h1>{t.hello}</h1><p>{t.recent}</p></div> : <div class="page-head"><h1>{t[page]}</h1>{page==='work'&&<p>{t.workIntro}</p>}{page==='thoughts'&&<p>{t.thoughtIntro}</p>}{page==='resources'&&<p>{t.resourceIntro}</p>}</div>}
{(page==='latest'||page==='thoughts')&&<section aria-label={t[page]} class="feed">{feed.map((e,index)=><article class="feed-entry" data-feed-entry hidden={index>=20}><div class="entry-meta"><span>{labels[e.type]}</span><span aria-hidden="true"> · </span><time datetime={e.date}>{e.date}</time></div>{e.type!=='thought'&&e.title&&<h2><a href={e.url}>{e.title}</a></h2>}<p>{e.body}</p><a class="entry-detail" href={e.url}>{t.detail}</a></article>)}{!feed.length&&<p class="empty">{t.emptyThought}</p>}{feed.length>20&&<button data-load-more data-end={t.end}>{lang==='zh'?'加载更多':lang==='de'?'Mehr laden':'Load more'}</button>}{feed.length>0&&<p class="feed-end" data-feed-end hidden={feed.length>20}>{t.end}</p>}</section>}
{page==='work'&&<>
{(filter==='all'||filter==='blog')&&<section class="work-section"><h2>{t.blog}</h2>{posts.length?posts.map(p=><a class="row" href={href(`/blog/${p.id}/`)}><div><h3>{p.data.title}</h3><p>{p.data.description}</p></div><time datetime={p.data.date.toISOString()}>{p.data.date.toISOString().slice(0,10)}</time></a>):<p class="empty-note">{t.emptyBlog}</p>}</section>}
{(filter==='all'||filter==='videos')&&<section class="work-section"><h2>{t.videos}</h2><p class="empty-note">{t.emptyVideo}</p></section>}
{(filter==='all'||filter==='projects')&&<section class="work-section"><h2>{t.projects}</h2>{projects.map(p=><a class="row" href={p.url}><div><span class="tag">{t.repo}</span><h3>{lang==='zh'?'道路交通法检索增强生成项目':p.title} ↗</h3><p>{t.repoDesc}</p></div></a>)}</section>}
</>}
{page==='resources'&&<><section class="work-section"><h2>{t.files}</h2><p class="empty-note">{t.emptyFiles}</p></section></>}
{page==='about'&&<article class="prose"><p>{t.aboutText}</p><h2>{t.elsewhere}</h2><ul class="contact-list"><li><a href="https://github.com/chmmao">GitHub ↗</a></li><li><a href="https://www.linkedin.com/in/chmmao/">{lang==='zh'?'领英主页':'LinkedIn'} ↗</a></li><li><a href="mailto:astro.chmmao@gmail.com">{t.email}: astro.chmmao@gmail.com</a></li></ul></article>}
<noscript><style>#main [data-feed-entry][hidden]{display:block!important}#main [data-load-more]{display:none!important}#main [data-feed-end][hidden]{display:block!important}</style></noscript>
</Base>
<script>
const more=document.querySelector<HTMLButtonElement>('[data-load-more]');
if(more){const show=()=>{const pending=[...document.querySelectorAll<HTMLElement>('[data-feed-entry][hidden]')];pending.slice(0,20).forEach(e=>e.hidden=false);if(pending.length<=20){more.hidden=true;document.querySelector<HTMLElement>('[data-feed-end]')!.hidden=false;observer?.disconnect();}};const observer='IntersectionObserver' in window?new IntersectionObserver(entries=>{if(entries.some(e=>e.isIntersecting))show();},{rootMargin:'150px'}):null;more.addEventListener('click',show);observer?.observe(more);}
</script>
