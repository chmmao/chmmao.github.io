---
import '../styles/global.css';
import { ui } from '../data/hub';
interface Props { title?: string; description?: string; lang?: 'en' | 'de' | 'zh'; }
const { title = 'Home', lang = 'en' } = Astro.props;
const de = lang === 'de';
const zh = lang === 'zh';
const text = (en: string, german: string, chinese: string) => zh ? chinese : de ? german : en;
const description = Astro.props.description ?? text('The personal website of Chuanming Mao. Notes, projects, and small tools.', 'Die persönliche Website von Chuanming Mao. Notizen, Projekte und kleine Tools.', 'Chuanming Mao 的个人网站。文字、项目和小工具。');
const path = Astro.url.pathname.replace(/^\/(de|zh)(?=\/|$)/, '') || '/';
const home = lang === 'en' ? '/' : `/${lang}/`;
const local = (url: string) => lang === 'en' ? url : `/${lang}${url}`;
const t=ui[lang];
const nav = [[t.latest,'/'],[t.work,'/work/'],[t.thoughts,'/thoughts/'],[t.resources,'/resources/'],[t.about,'/about/']];
const workActive=path.startsWith('/work/')||path.startsWith('/blog/')||path.startsWith('/projects/');
const active=(href:string)=>href==='/'?path==='/'||path.startsWith('/updates/'):href==='/work/'?workActive:href==='/resources/'?path.startsWith('/resources/')||path.startsWith('/tools/'):path.startsWith(href);
const subnav = [[t.all,'/work/'],[t.blog,'/work/blog/'],[t.videos,'/work/videos/'],[t.projects,'/work/projects/']];
const paired = ['/', '/work/', '/work/blog/', '/work/videos/', '/work/projects/', '/thoughts/', '/resources/', '/blog/', '/projects/', '/tools/', '/tools/text-counter/', '/about/'].includes(path)||path.startsWith('/updates/');
const switchPath = paired ? path : path.startsWith('/blog/') ? '/work/blog/' : '/';
const pageTitle = title === 'Home' ? 'chmmao — Chuanming Mao' : `${title} · chmmao`;
---
<!doctype html><html lang={zh ? 'zh-CN' : lang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{pageTitle}</title><meta name="description" content={description}/><link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}/>{paired && <><link rel="alternate" hreflang="en" href={new URL(path,Astro.site)}/><link rel="alternate" hreflang="de" href={new URL(`/de${path}`,Astro.site)}/><link rel="alternate" hreflang="zh-CN" href={new URL(`/zh${path}`,Astro.site)}/><link rel="alternate" hreflang="x-default" href={new URL(path,Astro.site)}/></>}<link rel="icon" type="image/svg+xml" href="/favicon.svg"/><meta property="og:title" content={pageTitle}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:locale" content={text('en_US','de_DE','zh_CN')}/><meta property="og:url" content={Astro.url}/><meta name="theme-color" content="#f6f5ef"/></head><body><a class="skip" href="#main">{text('Skip to content','Zum Inhalt springen','跳到正文')}</a><div class="shell"><header><a class="wordmark" href={home} aria-label={text('chmmao home','chmmao Startseite','chmmao 首页')}>chmmao</a><div class="header-controls"><nav aria-label={text('Main navigation','Hauptnavigation','主导航')}>{nav.map(([label,href]) => <a href={local(href)} aria-current={active(href) ? 'page' : undefined}>{label}</a>)}</nav><nav class="language-switch" aria-label={text('Choose language','Sprache wählen','切换语言')}><a href={switchPath} lang="en" hreflang="en" aria-current={lang === 'en' ? 'true' : undefined}>English</a><span aria-hidden="true">/</span><a href={`/de${switchPath}`} lang="de" hreflang="de" aria-current={de ? 'true' : undefined}>Deutsch</a><span aria-hidden="true">/</span><a href={`/zh${switchPath}`} lang="zh-CN" hreflang="zh-CN" aria-current={zh ? 'true' : undefined}>中文</a></nav></div></header><main id="main">{workActive&&<nav class="subnav" aria-label={text('Work categories','Werk-Kategorien','作品分类')}>{subnav.map(([label,href])=><a href={local(href)} aria-current={(path===href||(href==='/work/blog/'&&path.startsWith('/blog/'))||(href==='/work/projects/'&&path.startsWith('/projects/'))) ? 'page':undefined}>{label}</a>)}</nav>}<slot/></main></div></body></html>
