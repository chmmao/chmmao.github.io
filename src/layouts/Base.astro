---
import '../styles/global.css';
const { title = 'Home', description = 'Chuanming Mao 的个人网站。记录想法、分享项目，也做一些小工具。' } = Astro.props;
const nav = [['Blog','/blog/'],['Projects','/projects/'],['Tools','/tools/'],['About','/about/']];
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title === 'Home' ? 'chmmao — Chuanming Mao' : `${title} · chmmao`}</title><meta name="description" content={description}/><link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><meta property="og:title" content={`${title} · chmmao`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={Astro.url}/><meta name="theme-color" content="#f6f5ef"/></head><body><a class="skip" href="#main">跳到正文</a><div class="shell"><header><a class="wordmark" href="/" aria-label="chmmao 首页">chmmao<span>✳</span></a><nav aria-label="主导航">{nav.map(([label,href]) => <a href={href} aria-current={Astro.url.pathname.startsWith(href) ? 'page' : undefined}>{label}</a>)}</nav></header><main id="main"><slot/></main><footer><span>© {new Date().getFullYear()} Chuanming Mao</span><div><span class="footnote">A small corner of the internet.</span><a href="https://github.com/chmmao">GitHub ↗</a><a href="https://www.linkedin.com/in/chmmao/">LinkedIn ↗</a></div></footer></div></body></html>
