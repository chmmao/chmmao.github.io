---
import '../styles/global.css';
interface Props { title?: string; description?: string; lang?: 'en' | 'de'; }
const { title = 'Home', lang = 'en' } = Astro.props;
const de = lang === 'de';
const description = Astro.props.description ?? (de ? 'Die persönliche Website von Chuanming Mao. Notizen, Projekte und kleine Tools.' : 'The personal website of Chuanming Mao. Notes, projects, and small tools.');
const path = Astro.url.pathname.replace(/^\/de(?=\/|$)/, '') || '/';
const home = de ? '/de/' : '/';
const local = (url: string) => de ? `/de${url}` : url;
const nav = [[ 'Blog','/blog/'],[de ? 'Projekte' : 'Projects','/projects/'],['Tools','/tools/'],[de ? 'Über mich' : 'About','/about/']];
const paired = ['/', '/blog/', '/projects/', '/tools/', '/tools/text-counter/', '/about/'].includes(path);
const switchPath = paired ? path : path.startsWith('/blog/') ? '/blog/' : '/';
const pageTitle = title === 'Home' ? 'chmmao — Chuanming Mao' : `${title} · chmmao`;
---
<!doctype html><html lang={lang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{pageTitle}</title><meta name="description" content={description}/><link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}/>{paired && <><link rel="alternate" hreflang="en" href={new URL(path,Astro.site)}/><link rel="alternate" hreflang="de" href={new URL(`/de${path}`,Astro.site)}/><link rel="alternate" hreflang="x-default" href={new URL(path,Astro.site)}/></>}<link rel="icon" type="image/svg+xml" href="/favicon.svg"/><meta property="og:title" content={pageTitle}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:locale" content={de ? 'de_DE' : 'en_US'}/><meta property="og:url" content={Astro.url}/><meta name="theme-color" content="#f6f5ef"/></head><body><a class="skip" href="#main">{de ? 'Zum Inhalt springen' : 'Skip to content'}</a><div class="shell"><header><a class="wordmark" href={home} aria-label={de ? 'chmmao Startseite' : 'chmmao home'}>chmmao<span>✳</span></a><div class="header-controls"><nav aria-label={de ? 'Hauptnavigation' : 'Main navigation'}>{nav.map(([label,href]) => <a href={local(href)} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>)}</nav><nav class="language-switch" aria-label={de ? 'Sprache wählen' : 'Choose language'}><a href={switchPath} lang="en" hreflang="en" aria-current={!de ? 'true' : undefined}>English</a><span aria-hidden="true">/</span><a href={`/de${switchPath}`} lang="de" hreflang="de" aria-current={de ? 'true' : undefined}>Deutsch</a></nav></div></header><main id="main"><slot/></main><footer><span>© {new Date().getFullYear()} Chuanming Mao</span><div><span class="footnote">{de ? 'Ein kleiner Ort im Internet.' : 'A small corner of the internet.'}</span><a href="https://github.com/chmmao">GitHub ↗</a><a href="https://www.linkedin.com/in/chmmao/">LinkedIn ↗</a></div></footer></div></body></html>
