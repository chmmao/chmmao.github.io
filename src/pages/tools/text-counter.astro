---
import CounterScript from '../../components/CounterScript.astro';
import Base from '../../layouts/Base.astro';
---
<Base title="Word counter"><div class="page-head"><a href="/tools/">← All tools</a><h1>Word counter</h1><p>How much have you written, and how long will it take to read? Your text is processed locally in your browser, never uploaded or saved.</p></div><section class="tool"><label for="text">Type or paste your text</label><textarea id="text" placeholder="Start writing here…"></textarea><div class="stats" aria-live="polite" aria-atomic="true"><div><strong id="words">0</strong><span>Words</span></div><div><strong id="characters">0</strong><span>Characters (with spaces)</span></div><div><strong id="minutes">0</strong><span>Minutes to read · estimate</span></div></div><p class="footnote">Chinese characters are counted individually; other languages are segmented into words. Reading time assumes about 300 words per minute.</p><button id="clear" type="button">Clear text</button></section></Base>
<CounterScript/>
