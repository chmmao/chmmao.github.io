---
import Base from '../layouts/Base.astro';
---
<Base title="404"><div class="page-head"><div class="eyebrow">404 / Not found</div><h1>A little off the beaten path.</h1><p>This page doesn’t exist, or it may have moved.</p><a class="button" href="/">Back home →</a></div></Base>

<script is:inline>
const locale = location.pathname.match(/^\/(zh|de)(?:\/|$)/)?.[1];
if(locale) location.replace('/'+locale+'/404/');
</script>
