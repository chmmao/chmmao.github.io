---
import Base from '../layouts/Base.astro';
import {getCollection} from 'astro:content';
const posts=(await getCollection('blog',({data})=>!data.draft && data.lang === 'en')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,3);
---
<Base><section class="hero"><div><div class="eyebrow">Chuanming Mao / Personal space</div><h1>Hi, I’m <em>chmmao.</em></h1><p class="lead">A place for ideas to take shape.<br/>Notes, projects, and small tools I build along the way.<br/>One note, one project at a time.</p><div class="links"><a class="button" href="/projects/">Explore projects ↗</a><a href="/about/" style="align-self:center">About me →</a></div></div></section><section class="section"><div class="section-head"><h2>Take a look around</h2><span class="eyebrow">Explore / 01—03</span></div><div class="tiles">{[['01 / BLOG','Notes & thoughts','Things I’m learning, trying, and still figuring out.','/blog/'],['02 / PROJECTS','Things I’ve built','Code, experiments, and the path from idea to implementation.','/projects/'],['03 / TOOLS','Useful little tools','Making everyday tasks a little simpler.','/tools/']].map(([n,t,d,h])=><a class="tile" href={h}><small>{n}</small><h3>{t}</h3><p>{d}</p><span class="arrow">Take a look ↗</span></a>)}</div></section><section class="section"><div class="section-head"><h2>Latest notes</h2><a href="/blog/">All posts →</a></div>{posts.length ? posts.map(post=><a class="row" href={`/blog/${post.id}/`}><div><h2>{post.data.title}</h2><p>{post.data.description}</p></div><time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0,10)}</time></a>):<p class="lead">The first post is on its way. This little site is the starting point.</p>}</section></Base>
