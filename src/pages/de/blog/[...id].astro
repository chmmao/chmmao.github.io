---
import {getCollection,render} from 'astro:content';
import Base from '../../../layouts/Base.astro';
export async function getStaticPaths(){return (await getCollection('blog',({data})=>!data.draft && data.lang === 'de')).map(post=>({params:{id:post.id},props:{post}}));}
const {post}=Astro.props;
const {Content}=await render(post);
---
<Base lang="de" title={post.data.title} description={post.data.description}><div class="page-head"><a href="/de/blog/">← Alle Beiträge</a><h1>{post.data.title}</h1><time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0,10)}</time></div><article class="prose"><Content/></article></Base>
