---
import Base from '../../layouts/Base.astro';
import {getCollection} from 'astro:content';
const posts=(await getCollection('blog',({data})=>!data.draft && data.lang === 'de')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,3);
---
<Base lang="de"><section class="hero"><div><div class="eyebrow">Chuanming Mao / Persönlicher Raum</div><h1>Hallo, ich bin<br/><em>chmmao.</em></h1><p class="lead">Ein Ort, an dem Ideen Gestalt annehmen.<br/>Notizen, Projekte und kleine Tools, die unterwegs entstehen.<br/>Eine Notiz, ein Projekt nach dem anderen.</p><div class="links"><a class="button" href="/de/projects/">Projekte ansehen ↗</a><a href="/de/about/" style="align-self:center">Über mich →</a></div></div><div class="art" aria-hidden="true"><b>cm.</b><small>IDEEN · NOTIZEN · PROJEKTE</small></div></section><section class="section"><div class="section-head"><h2>Schau dich um</h2><span class="eyebrow">Entdecken / 01—03</span></div><div class="tiles">{[['01 / BLOG','Notizen & Gedanken','Was ich lerne, ausprobiere und noch herausfinden möchte.','/de/blog/'],['02 / PROJEKTE','Meine Projekte','Code, Experimente und der Weg von der Idee zur Umsetzung.','/de/projects/'],['03 / TOOLS','Kleine Helfer','Kleine Alltagsaufgaben etwas einfacher machen.','/de/tools/']].map(([n,t,d,h])=><a class="tile" href={h}><small>{n}</small><h3>{t}</h3><p>{d}</p><span class="arrow">Mehr erfahren ↗</span></a>)}</div></section><section class="section"><div class="section-head"><h2>Neueste Notizen</h2><a href="/de/blog/">Alle Beiträge →</a></div>{posts.length ? posts.map(post=><a class="row" href={`/de/blog/${post.id}/`}><div><h2>{post.data.title}</h2><p>{post.data.description}</p></div><time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0,10)}</time></a>):<p class="lead">Der erste Beitrag kommt noch. Diese kleine Website ist der Anfang.</p>}</section></Base>
